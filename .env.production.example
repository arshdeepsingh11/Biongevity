# ─────────────────────────────────────────────────────────────
# Biongevity · PRODUCTION build settings (copy to .env.production on the build machine / CI)
# Every NEXT_PUBLIC_ value is baked into the public site at build time — NO secrets here.
# ─────────────────────────────────────────────────────────────

# Live domain (canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://biongevity.com

# Member app (Join, Sign in, Book consult, Digital Twin links)
NEXT_PUBLIC_APP_URL=https://app.biongevity.com

# Biongevity SI chat → the Cloudflare Worker URL (deploy/xevyo-worker.js). The Xevyo key lives ONLY in the Worker.
NEXT_PUBLIC_XEVYO_URL=https://<your-worker>.workers.dev
NEXT_PUBLIC_XEVYO_MODEL=xevyo
# Leave empty in production — the Worker adds the key on the server side.
NEXT_PUBLIC_XEVYO_PUBLIC_KEY=

# Optional
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_CONTACT_ENDPOINT=
