# ─────────────────────────────────────────────────────────────
# Biongevity · environment
# Static export: every value below is PUBLIC (bundled into the browser).
# Never put secrets here. Use publishable / rate-limited endpoints only.
# ─────────────────────────────────────────────────────────────

# Xevyo — in-house AI. POST JSON → JSON or text/event-stream. Empty = chat shows "not connected".
NEXT_PUBLIC_XEVYO_URL=
# Optional publishable key, sent as `Authorization: Bearer <key>` (must be browser-safe).
NEXT_PUBLIC_XEVYO_PUBLIC_KEY=

# Shopify — store domain for cart permalinks (e.g. biongevity.myshopify.com).
# Map product handles → variant ids in src/config/shopify.ts. Empty = links open official store pages.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Contact form — optional webhook (POST JSON), e.g. Shopify Flow / form service.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Canonical site URL.
NEXT_PUBLIC_SITE_URL=https://biongevity.com
