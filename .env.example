# ─────────────────────────────────────────────────────────────
# Biongevity · environment
# Static export: every value below is PUBLIC (bundled into the browser).
# Never put secrets here. Use publishable / rate-limited endpoints only.
# ─────────────────────────────────────────────────────────────

# Biongevity SI (Xevyo backend). POST JSON → JSON or text/event-stream. Empty = chat shows "not connected".
# Xevyo's API: https://chat.xevyo.com/xevyo/v1/chat/completions  (NOT platform.xevyo.com — that is the console website)
# Recommended: point this at the secure proxy (see docs/XEVYO_PROXY.md):
#   development → http://localhost:8787 (run `npm run si:proxy`)   production → your Cloudflare Worker URL
NEXT_PUBLIC_XEVYO_URL=
# Server-only values read by scripts/xevyo-proxy.mjs (never NEXT_PUBLIC_, never sent to the browser).
XEVYO_UPSTREAM_URL=https://chat.xevyo.com/xevyo/v1/chat/completions
XEVYO_API_KEY=
# Publishable key (xk-…), sent as `Authorization: Bearer <key>`. Must be browser-safe:
# domain-locked + rate-limited by the Xevyo team. Put the real value in .env.local (git-ignored), never here.
NEXT_PUBLIC_XEVYO_PUBLIC_KEY=
# Optional model name, only if the Xevyo endpoint asks for one (OpenAI-style APIs).
NEXT_PUBLIC_XEVYO_MODEL=xevyo

# Shopify — store domain for cart permalinks (e.g. biongevity.myshopify.com).
# Map product handles → variant ids in src/config/shopify.ts. Empty = links open official store pages.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Contact form — optional webhook (POST JSON), e.g. Shopify Flow / form service.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Biongevity member app — digital twin, results, coach, clinician and family portals.
# "Sign in" and "Open my twin" link here. Default: https://app.biongevity.com
NEXT_PUBLIC_APP_URL=https://app.biongevity.com

# Canonical site URL.
NEXT_PUBLIC_SITE_URL=https://biongevity.com
