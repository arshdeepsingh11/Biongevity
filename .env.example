# ─────────────────────────────────────────────────────────────
# Biongevity · environment
# Static export: every value below is PUBLIC (bundled into the browser).
# Never put secrets here. Use publishable / rate-limited endpoints only.
# ─────────────────────────────────────────────────────────────

# Biongevity SI (Xevyo backend). POST JSON → JSON or text/event-stream. Empty = chat shows "not connected".
# Xevyo's API: https://chat.xevyo.com/xevyo/v1/chat/completions  (NOT platform.xevyo.com — that is the console website)
# Recommended: point this at the secure proxy (see docs/XEVYO_PROXY.md):
#   development → http://127.0.0.1:8787 (run `npm run si:proxy`)   production → your Cloudflare Worker URL
NEXT_PUBLIC_XEVYO_URL=
# Server-only values read by scripts/xevyo-proxy.mjs (never NEXT_PUBLIC_, never sent to the browser).
XEVYO_UPSTREAM_URL=https://chat.xevyo.com/xevyo/v1/chat/completions
XEVYO_API_KEY=
# Publishable key (xk-…), sent as `Authorization: Bearer <key>`. Must be browser-safe:
# domain-locked + rate-limited by the Xevyo team. Put the real value in .env.local (git-ignored), never here.
NEXT_PUBLIC_XEVYO_PUBLIC_KEY=
# Optional model name, only if the Xevyo endpoint asks for one (OpenAI-style APIs).
NEXT_PUBLIC_XEVYO_MODEL=xevyo

# Shopify — store domain for cart permalinks (e.g. biongevity.myshopify.com).
# Map product handles → variant ids in src/config/shopify.ts. Empty = links open official store pages.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Public Storefront API token from Shopify admin → Headless → Biongevity → Storefront API (public token only, never the private shpat_ one).
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Forms Worker (deploy/forms, docs/ADMIN_FORMS.md): saves contact enquiries and powers /admin.
# e.g. https://forms.biongevity.com — the contact form then posts to <this>/contact.
NEXT_PUBLIC_FORMS_URL=
# Contact form — optional override (otherwise the forms Worker above); a webhook (POST JSON), e.g. Shopify Flow / form service.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Biongevity member app — digital twin, results, coach, clinician and family portals.
# "Sign in" and "Open my twin" link here. Default: https://app.biongevity.com
NEXT_PUBLIC_APP_URL=https://app.biongevity.com

# Canonical site URL.
NEXT_PUBLIC_SITE_URL=https://biongevity.com

# Business WhatsApp for the fixed button (bottom right) and every "WhatsApp us" link: country code + number, digits only.
# Default when empty: the clinic's business WhatsApp, 971505282566 (+971 50 528 2566).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Tag Manager container. Empty = Biongevity's container GTM-PH9BZ2TR (built in). "off" = no GTM (local tests).
# GA4 (G-GKPG2B7BWE) is configured INSIDE GTM as a Google tag, never in the code (avoids double counting). See docs/TRACKING.md.
NEXT_PUBLIC_GTM_ID=

# AI assistant (Dubai pages). Built by the AI team; the website provides the panel, highlight-to-ask and hand-off.
# Chat endpoint (OpenAI-style …/chat/completions, SSE or JSON). Empty = falls back to NEXT_PUBLIC_XEVYO_URL; both empty = AI off
# (the panel then shows matching site pages + WhatsApp, clearly marked "not an AI answer"). See docs/AI_INTEGRATION.md.
NEXT_PUBLIC_AI_URL=
NEXT_PUBLIC_AI_MODEL=
# Optional: receives the conversation (JSON) when a visitor taps Book/WhatsApp in the assistant or closes it, for the EMR/ELR.
NEXT_PUBLIC_AI_HANDOFF_URL=
