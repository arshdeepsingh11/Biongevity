# ── Shopify Storefront API (provided by the store developer) ──
# Leave empty to run with the built-in catalog (demo mode, local cart).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# ── Optional AI endpoint for Biongevity AI (POST {prompt} -> {text}) ──
# Leave empty to use the built-in prepared answers.
NEXT_PUBLIC_AI_ENDPOINT=
